NAME = libftprintf.a
CC = cc -g
CFLAGS = -Wall -Wextra -Werror

SRC = 

OBJ = $SRC:%.c=%.o

all: $(NAME)
%.o: %.c 
    $(CC) $(CFLAGS) -c $< -o $@ 
$(NAME): $(OBJ)
    $(CC) $(CFLAGS) -o $@ $^ 
    @echo "ft_printf is created"
clean:
    @rm -rf %.o 
fclean: clean
    @rm -rf $(NAME)
re: fclean all 